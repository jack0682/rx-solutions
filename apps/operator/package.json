  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "typescript": "^6.0.0",
    "vite": "8.2.2",
    "vitest": "^5.0.0"
  },
  "license": "Apache-2.0"
}
